VITE_BASE=/ui

## 接口地址
# VITE_GLOB_API_URL=https://mock-napi.vben.pro/api
# caddy proxy
VITE_GLOB_API_URL=http://localhost/api/v1

## ws url
# VITE_GLOB_WS_URL=ws://localhost:10081/ws/v1
# caddy proxy
VITE_GLOB_WS_URL=ws://localhost/ws/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
