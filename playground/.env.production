VITE_BASE=/ui

## 接口地址
# 直连 Go API (admin 端口 10081)
# VITE_GLOB_API_URL=http://localhost:10081/api/v1
# caddy proxy (https)
VITE_GLOB_API_URL=https://localhost/api/v1

## ws url
# 直连 Go API
# VITE_GLOB_WS_URL=ws://localhost:10081/ws/v1
# caddy proxy (wss)
VITE_GLOB_WS_URL=wss://localhost/ws/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
