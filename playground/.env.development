# 端口号
VITE_PORT=5555

VITE_BASE=/ui

## 接口地址
# 直连 Go API (admin 端口 10081)
# VITE_GLOB_API_URL=http://localhost:10081/api/v1

# caddy proxy - https
VITE_GLOB_API_URL=https://localhost/api/v1

## ws url
# 直连 Go API
# VITE_GLOB_WS_URL=ws://localhost:10081/ws/v1

# caddy proxy - wss
VITE_GLOB_WS_URL=wss://localhost/ws/v1

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 钉钉登录配置
VITE_GLOB_AUTH_DINGDING_CLIENT_ID=应用的clientId
VITE_GLOB_AUTH_DINGDING_CORP_ID=应用的corpId
